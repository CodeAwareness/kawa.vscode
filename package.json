{
  "name": "vscode-huggin",
  "displayName": "Kawa Code",
  "description": "Universal Context Platform.",
  "icon": "media/icons/kawacode-logo.png",
  "version": "4.0.5",
  "publisher": "CodeAwareness",
  "author": "Mark Vasile",
  "repository": "https://github.com/CodeAwareness/caw.vscode",
  "bugs": "https://github.com/CodeAwareness/caw.vscode/issues",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "keywords": [
    "universal context",
    "collaboration"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/web/extension.js",
  "browser": "./dist/web/extension.js",
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "Using Kawa Code is not currently possible in virtual workspaces."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "caw.toggle",
        "title": "%extension.toggle%"
      },
      {
        "command": "caw.nextPeer",
        "title": "%extension.nextPeer%"
      },
      {
        "command": "caw.prevPeer",
        "title": "%extension.prevPeer%"
      },
      {
        "command": "caw.mergeSlice",
        "title": "%extension.mergeSlice%"
      },
      {
        "command": "caw.mergeAll",
        "title": "%extension.mergeAll%"
      },
      {
        "command": "caw.openPeerFile",
        "title": "%extension.openPeerFile%"
      },
      {
        "command": "caw.openDiff",
        "title": "%extension.openDiff%"
      },
      {
        "command": "caw.refresh",
        "title": "%extension.refresh%"
      },
      {
        "command": "caw.selectRange",
        "title": "%extension.selectRange%"
      },
      {
        "command": "caw.openFile",
        "title": "%extension.openFile%"
      },
      {
        "command": "caw.selectLanguage",
        "title": "Kawa Code: Select Coding Language",
        "category": "Kawa Code"
      },
      {
        "command": "caw.translateToLanguage",
        "title": "Translate to Selected Language",
        "category": "Kawa Code"
      }
    ],
    "keybindings": [
      {
        "command": "caw.toggle",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      },
      {
        "command": "caw.highlight",
        "key": "shift+f12",
        "mac": "shift+f12"
      },
      {
        "command": "caw.nextPeer",
        "key": "ctrl+alt+]",
        "mac": "cmd+alt+]"
      },
      {
        "command": "caw.prevPeer",
        "key": "ctrl+alt+[",
        "mac": "cmd+alt+["
      },
      {
        "command": "caw.mergeSlice",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "codeAwareness",
          "name": "Peer Diffs",
          "icon": "media/code.png",
          "contextualTitle": "Files changed at peers.",
          "when": "workbenchState != empty"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "caw.toggle"
        },
        {
          "command": "caw.nextPeer"
        },
        {
          "command": "caw.prevPeer"
        },
        {
          "command": "caw.mergeAll"
        },
        {
          "command": "caw.mergeSlice"
        },
        {
          "command": "caw.selectRange"
        },
        {
          "command": "caw.selectLanguage"
        },
        {
          "command": "caw.translateToLanguage"
        }
      ],
      "scm/resourceGroup/context": [
        {
          "command": "caw.mergeAll",
          "when": "scmProvider == cΩ",
          "group": "1_modification"
        }
      ],
      "scm/resourceFolder/context": [
        {
          "command": "caw.mergeAll",
          "when": "scmProvider == cΩ",
          "group": "inline"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "caw.openFile",
          "when": "scmProvider == cΩ",
          "group": "navigation"
        },
        {
          "command": "caw.openDiff",
          "when": "scmProvider == cΩ",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "caw.openFile",
          "when": "scmProvider == cΩ",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "caw.selectRange",
          "when": "scmProvider == cΩ",
          "group": "2_cΩ@1"
        }
      ],
      "scm/change/title": [
        {
          "command": "caw.mergeSlice",
          "when": "scmProvider == cΩ"
        }
      ]
    },
    "configuration": {
      "title": "Kawa Code",
      "properties": {
        "KawaCode.catalog": {
          "type": "string",
          "default": "catalog",
          "description": "%caw.config.catalog%",
          "scope": "application"
        },
        "KawaCode.highlight_while_closed": {
          "type": "boolean",
          "default": true,
          "description": "%caw.config.highlight_while_closed",
          "scope": "application"
        }
      }
    }
  },
  "scripts": {
    "test": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. --extensionTestsPath=dist/web/test/suite/index.js",
    "pretest": "npm run compile-web",
    "vscode:prepublish": "npm run package-web",
    "package": "npm run package-web && vsce package",
    "compile-web": "webpack",
    "package-web": "./prepare-prod.sh ; webpack --mode production --devtool hidden-source-map",
    "watch-web": "webpack --watch",
    "lint": "eslint src --ext ts",
    "run-in-browser": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. ."
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.7.2",
    "@types/vscode": "^1.105.0",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "@vscode/test-web": "^0.0.74",
    "assert": "^2.1.0",
    "babel-jest": "^30.2.0",
    "eslint": "^9.37.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-n": "^17.23.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-security": "^3.0.1",
    "eslint-watch": "^8.0.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.4",
    "mocha": "^11.7.4",
    "path": "^0.12.7",
    "ts-jest": "^29.4.5",
    "ts-loader": "^9.5.4",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@changesets/cli": "^2.29.7",
    "lodash": "^4.17.21",
    "process": "^0.11.10",
    "sass": "^1.93.2",
    "vscode-nls": "^5.2.0"
  }
}
